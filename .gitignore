# Build output - everything here is regenerated by the build scripts
build/
dist/
__pycache__/
*.spec
*.pyc
.venv-build/

# Generated icons (make_icon.py rebuilds them)
app_icon.ico
app_icon.icns
app_icon.png

# Note: web/ IS committed on purpose. It is generated by make_web.py, but
# committing it means Vercel can serve the site with no build step and no
# Python on the build image. Re-run make_web.py after editing
# save-now-web.html, then commit the result.

# Packaged output
*.zip

# Local tooling
.vercel/
.DS_Store
Thumbs.db
